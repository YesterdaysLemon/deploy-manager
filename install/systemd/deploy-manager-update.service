[Unit]
Description=Promote a green Deploy Manager main release
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/deploy-manager/self-update.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/update-deploy-manager
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0022
