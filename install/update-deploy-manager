#!/usr/bin/env sh
set -eu

# This file is installed as /usr/local/sbin/update-deploy-manager. It is part of
# the manually promoted, root-owned control plane and is never replaced by an
# automatic update. Pulled repository code is validated as an unprivileged build
# user, then installed read-only under a versioned SHA directory.

PATH="${DEPLOY_MANAGER_UPDATE_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
export PATH

PROGRAM="update-deploy-manager"
CONFIG_FILE="${DEPLOY_MANAGER_UPDATE_CONFIG:-/etc/deploy-manager/self-update.env}"

if [ -r "$CONFIG_FILE" ]; then
  # The config is installed root-owned and contains only updater settings.
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

REPOSITORY="${DEPLOY_MANAGER_UPDATE_REPOSITORY:-YesterdaysLemon/deploy-manager}"
BRANCH="${DEPLOY_MANAGER_UPDATE_BRANCH:-main}"
WORKFLOW="${DEPLOY_MANAGER_UPDATE_WORKFLOW:-check.yml}"
RELEASE_ROOT="${DEPLOY_MANAGER_RELEASE_ROOT:-/opt/deploy-manager-releases}"
ACTIVE_LINK="${DEPLOY_MANAGER_ACTIVE_LINK:-/opt/deploy-manager-current}"
STATE_DIR="${DEPLOY_MANAGER_UPDATE_STATE_DIR:-/var/lib/deploy-manager-update}"
LOCK_FILE="${DEPLOY_MANAGER_UPDATE_LOCK_FILE:-/run/lock/deploy-manager-update.lock}"
MANAGER_ENV="${DEPLOY_MANAGER_ENV_FILE:-/etc/deploy-manager/deploy-manager.env}"
SERVICE="${DEPLOY_MANAGER_SERVICE:-deploy-manager.service}"
BUILD_USER="${DEPLOY_MANAGER_BUILD_USER:-deploy-manager-build}"
BUILD_HOME="${DEPLOY_MANAGER_BUILD_HOME:-/var/lib/deploy-manager-build}"
API_ROOT="${DEPLOY_MANAGER_GITHUB_API_ROOT:-https://api.github.com}"
TOKEN_FILE="${DEPLOY_MANAGER_GITHUB_TOKEN_FILE:-}"
REQUIRE_DEFAULT_BRANCH="${DEPLOY_MANAGER_REQUIRE_DEFAULT_BRANCH:-1}"
CHECK_TIMEOUT_SECONDS="${DEPLOY_MANAGER_CHECK_TIMEOUT_SECONDS:-300}"
HEALTH_ATTEMPTS="${DEPLOY_MANAGER_UPDATE_HEALTH_ATTEMPTS:-30}"
HEALTH_SLEEP_SECONDS="${DEPLOY_MANAGER_UPDATE_HEALTH_SLEEP_SECONDS:-1}"
MAX_ARCHIVE_BYTES="${DEPLOY_MANAGER_UPDATE_MAX_ARCHIVE_BYTES:-52428800}"
TEST_MODE="${DEPLOY_MANAGER_UPDATE_TEST_MODE:-0}"
REQUESTED_SHA=""
PREFLIGHT_ONLY="0"

log() {
  printf '%s %s %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$PROGRAM" "$*"
}

fail() {
  log "failure reason=$*" >&2
  exit 1
}

usage() {
  echo "usage: $PROGRAM [--preflight] [--sha <40-character-main-sha>]" >&2
  exit 64
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --preflight)
      PREFLIGHT_ONLY="1"
      shift
      ;;
    --sha)
      [ "$#" -ge 2 ] || usage
      REQUESTED_SHA="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

case "$REPOSITORY" in
  */*) ;;
  *) fail "invalid_repository" ;;
esac

case "$REPOSITORY$BRANCH$WORKFLOW" in
  *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._/-]*)
    fail "unsafe_repository_branch_or_workflow"
    ;;
esac

case "$REQUESTED_SHA" in
  "") ;;
  *[!0123456789abcdefABCDEF]*) fail "invalid_requested_sha" ;;
esac

if [ -n "$REQUESTED_SHA" ] && [ "${#REQUESTED_SHA}" -ne 40 ]; then
  fail "invalid_requested_sha"
fi

if [ "$TEST_MODE" != "1" ] && [ "$(id -u)" -ne 0 ]; then
  fail "must_run_as_root"
fi

for command_name in curl node; do
  command -v "$command_name" >/dev/null 2>&1 || fail "missing_command_$command_name"
done

cleanup_stage=""
cleanup_archive=""

# Invoked indirectly by trap.
# shellcheck disable=SC2329
cleanup() {
  if [ -n "$cleanup_stage" ]; then
    case "$cleanup_stage" in
      "$RELEASE_ROOT"/.staging.*) rm -rf -- "$cleanup_stage" ;;
    esac
  fi
  if [ -n "$cleanup_archive" ]; then
    case "$cleanup_archive" in
      "$STATE_DIR"/archive.*.tar.gz) rm -f -- "$cleanup_archive" ;;
    esac
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

github_get() {
  url="$1"
  if [ -n "$TOKEN_FILE" ]; then
    [ -r "$TOKEN_FILE" ] || fail "github_token_file_not_readable"
    token="$(sed -n '1p' "$TOKEN_FILE")"
    [ -n "$token" ] || fail "github_token_file_empty"
    case "$token" in
      *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*)
        fail "github_token_file_invalid"
        ;;
    esac
    curl --fail --silent --show-error --location \
      --retry 3 --connect-timeout 15 --max-time 60 \
      --header "Accept: application/vnd.github+json" \
      --header "X-GitHub-Api-Version: 2022-11-28" \
      --config - "$url" <<EOF
header = "Authorization: Bearer $token"
EOF
    return
  fi

  curl --fail --silent --show-error --location \
    --retry 3 --connect-timeout 15 --max-time 60 \
    --header "Accept: application/vnd.github+json" \
    --header "X-GitHub-Api-Version: 2022-11-28" \
    "$url"
}

repo_json="$(github_get "$API_ROOT/repos/$REPOSITORY")" || fail "repository_lookup_failed"
default_branch="$(printf '%s' "$repo_json" | node -e '
let input = "";
process.stdin.on("data", (chunk) => (input += chunk));
process.stdin.on("end", () => {
  const value = JSON.parse(input).default_branch;
  if (typeof value !== "string" || !value) process.exit(1);
  process.stdout.write(value);
});
')" || fail "repository_metadata_invalid"

if [ "$REQUIRE_DEFAULT_BRANCH" = "1" ] && [ "$default_branch" != "$BRANCH" ]; then
  fail "default_branch_is_${default_branch}_expected_${BRANCH}"
fi

commit_json="$(github_get "$API_ROOT/repos/$REPOSITORY/commits/$BRANCH")" || fail "branch_lookup_failed"
latest_sha="$(printf '%s' "$commit_json" | node -e '
let input = "";
process.stdin.on("data", (chunk) => (input += chunk));
process.stdin.on("end", () => {
  const value = JSON.parse(input).sha;
  if (typeof value !== "string" || !/^[0-9a-f]{40}$/i.test(value)) process.exit(1);
  process.stdout.write(value.toLowerCase());
});
')" || fail "branch_sha_invalid"

if [ -n "$REQUESTED_SHA" ] && [ "$(printf '%s' "$REQUESTED_SHA" | tr 'A-F' 'a-f')" != "$latest_sha" ]; then
  fail "requested_sha_is_not_current_main requested=$REQUESTED_SHA current=$latest_sha"
fi

target_sha="$latest_sha"
runs_json="$(github_get "$API_ROOT/repos/$REPOSITORY/actions/workflows/$WORKFLOW/runs?branch=$BRANCH&event=push&status=success&head_sha=$target_sha&per_page=100")" ||
  fail "workflow_lookup_failed sha=$target_sha"

if ! printf '%s' "$runs_json" | node -e '
let input = "";
process.stdin.on("data", (chunk) => (input += chunk));
process.stdin.on("end", () => {
  const sha = process.argv[1].toLowerCase();
  const runs = JSON.parse(input).workflow_runs;
  if (!Array.isArray(runs)) process.exit(1);
  const accepted = runs.some((run) =>
    String(run.head_sha ?? "").toLowerCase() === sha &&
    run.status === "completed" && run.conclusion === "success"
  );
  process.exit(accepted ? 0 : 1);
});
' "$target_sha"; then
  fail "no_successful_main_check sha=$target_sha workflow=$WORKFLOW"
fi

if [ "$PREFLIGHT_ONLY" = "1" ]; then
  log "preflight_success sha=$target_sha branch=$BRANCH workflow=$WORKFLOW"
  exit 0
fi

for command_name in env find flock install mv npm readlink runuser systemctl tar timeout; do
  command -v "$command_name" >/dev/null 2>&1 || fail "missing_command_$command_name"
done

BUILD_GROUP="$(id -gn "$BUILD_USER" 2>/dev/null || true)"
[ -n "$BUILD_GROUP" ] || fail "build_user_not_found user=$BUILD_USER"

install -d -o root -g root -m 0755 "$RELEASE_ROOT"
install -d -o root -g "$BUILD_GROUP" -m 0750 "$STATE_DIR"
install -d -o root -g root -m 0755 "$(dirname "$LOCK_FILE")"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "skip reason=update_already_running"
  exit 0
fi

if [ -e "$ACTIVE_LINK" ] && [ ! -L "$ACTIVE_LINK" ]; then
  fail "active_path_is_not_a_symlink path=$ACTIVE_LINK"
fi

previous_target=""
if [ -L "$ACTIVE_LINK" ]; then
  previous_target="$(readlink -f "$ACTIVE_LINK")"
  if [ "$(basename "$previous_target")" = "$target_sha" ]; then
    log "skip reason=already_current sha=$target_sha"
    exit 0
  fi
fi

archive="$(mktemp "$STATE_DIR/archive.${target_sha}.XXXXXX.tar.gz")"
cleanup_archive="$archive"
github_get "$API_ROOT/repos/$REPOSITORY/tarball/$target_sha" > "$archive" ||
  fail "archive_download_failed sha=$target_sha"
chown root:"$BUILD_GROUP" "$archive"
chmod 0640 "$archive"

archive_bytes="$(wc -c < "$archive" | tr -d ' ')"
case "$archive_bytes" in
  ""|*[!0123456789]*) fail "archive_size_invalid" ;;
esac
if [ "$archive_bytes" -gt "$MAX_ARCHIVE_BYTES" ]; then
  fail "archive_too_large bytes=$archive_bytes limit=$MAX_ARCHIVE_BYTES"
fi

extract_release() {
  destination="$1"
  install -d -o "$BUILD_USER" -g "$BUILD_GROUP" -m 0755 "$destination"
  runuser -u "$BUILD_USER" -- tar --no-same-owner --strip-components=1 -xzf "$archive" -C "$destination"
}

validate_release() {
  candidate="$1"
  [ -f "$candidate/package.json" ] || fail "release_missing_package_json"
  [ ! -L "$candidate/package.json" ] || fail "release_package_json_is_symlink"
  [ -f "$candidate/src/server.mjs" ] || fail "release_missing_server"
  [ ! -L "$candidate/src/server.mjs" ] || fail "release_server_is_symlink"
  if [ -n "$(find "$candidate" ! -type f ! -type d -print -quit)" ]; then
    fail "release_contains_non_regular_entry"
  fi

  node -e '
const fs = require("fs");
const pkg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
if (pkg.name !== "deploy-manager" || pkg.private !== true) process.exit(1);
for (const key of ["dependencies", "optionalDependencies", "peerDependencies"]) {
  if (pkg[key] && Object.keys(pkg[key]).length > 0) process.exit(1);
}
' "$candidate/package.json" || fail "release_runtime_dependency_contract_changed"
}

stage="$(mktemp -d "$RELEASE_ROOT/.staging.${target_sha}.XXXXXX")"
cleanup_stage="$stage"
chown "$BUILD_USER:$BUILD_GROUP" "$stage"
extract_release "$stage"
validate_release "$stage"

# $1 is intentionally expanded by the unprivileged inner shell.
# shellcheck disable=SC2016
if ! timeout "$CHECK_TIMEOUT_SECONDS" runuser -u "$BUILD_USER" -- \
  env HOME="$BUILD_HOME" sh -c 'cd "$1" && exec npm --ignore-scripts run check' sh "$stage"; then
  fail "release_checks_failed sha=$target_sha"
fi

# Tests run against an expendable tree. Re-extract the exact archive so test
# helpers cannot accidentally modify the release that will be activated.
case "$stage" in
  "$RELEASE_ROOT"/.staging.*) rm -rf -- "$stage" ;;
  *) fail "unsafe_stage_path" ;;
esac
stage="$(mktemp -d "$RELEASE_ROOT/.staging.${target_sha}.XXXXXX")"
cleanup_stage="$stage"
chown "$BUILD_USER:$BUILD_GROUP" "$stage"
extract_release "$stage"
validate_release "$stage"

fresh_commit_json="$(github_get "$API_ROOT/repos/$REPOSITORY/commits/$BRANCH")" ||
  fail "final_branch_lookup_failed"
fresh_sha="$(printf '%s' "$fresh_commit_json" | node -e '
let input = "";
process.stdin.on("data", (chunk) => (input += chunk));
process.stdin.on("end", () => {
  const value = JSON.parse(input).sha;
  if (typeof value !== "string" || !/^[0-9a-f]{40}$/i.test(value)) process.exit(1);
  process.stdout.write(value.toLowerCase());
});
')" || fail "final_branch_sha_invalid"
if [ "$fresh_sha" != "$target_sha" ]; then
  fail "main_moved_during_update target=$target_sha current=$fresh_sha"
fi

{
  echo "sha=$target_sha"
  echo "repository=$REPOSITORY"
  echo "branch=$BRANCH"
  echo "prepared_at=$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
} > "$stage/.deploy-manager-release"

chown -R root:root "$stage"
chmod -R go-w "$stage"

if [ ! -r "$MANAGER_ENV" ]; then
  fail "manager_env_not_readable path=$MANAGER_ENV"
fi

# Read only the service bind settings in a subshell. The manager environment
# also contains application secrets and must not be allowed to overwrite the
# updater's paths or control variables.
manager_network="$({
  DEPLOY_MANAGER_HOST="127.0.0.1"
  DEPLOY_MANAGER_PORT="9000"
  # shellcheck disable=SC1090
  . "$MANAGER_ENV"
  printf '%s\n%s\n' "$DEPLOY_MANAGER_HOST" "$DEPLOY_MANAGER_PORT"
})"
DEPLOY_MANAGER_HOST="$(printf '%s\n' "$manager_network" | sed -n '1p')"
DEPLOY_MANAGER_PORT="$(printf '%s\n' "$manager_network" | sed -n '2p')"
case "$DEPLOY_MANAGER_HOST" in
  ""|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.:-]*)
    fail "invalid_manager_host"
    ;;
esac
case "$DEPLOY_MANAGER_PORT" in
  ""|*[!0123456789]*) fail "invalid_manager_port" ;;
esac
if [ "$DEPLOY_MANAGER_PORT" -lt 1 ] || [ "$DEPLOY_MANAGER_PORT" -gt 65535 ]; then
  fail "invalid_manager_port"
fi
health_url="${DEPLOY_MANAGER_UPDATE_HEALTH_URL:-http://${DEPLOY_MANAGER_HOST}:${DEPLOY_MANAGER_PORT}/healthz}"

health_check() {
  attempt=1
  while [ "$attempt" -le "$HEALTH_ATTEMPTS" ]; do
    if curl --fail --silent --show-error --max-time 5 --output /dev/null "$health_url"; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep "$HEALTH_SLEEP_SECONDS"
  done
  return 1
}

release="$RELEASE_ROOT/$target_sha"
if [ -e "$release" ]; then
  case "$release" in
    "$RELEASE_ROOT/$target_sha")
      [ ! -L "$release" ] || fail "inactive_release_is_symlink sha=$target_sha"
      rm -rf -- "$release"
      ;;
    *) fail "unsafe_existing_release_path sha=$target_sha" ;;
  esac
fi
mv "$stage" "$release"
cleanup_stage=""

link_temp="${ACTIVE_LINK}.new.$$"
rm -f -- "$link_temp"
ln -s "$release" "$link_temp"
mv -Tf "$link_temp" "$ACTIVE_LINK"

if systemctl daemon-reload && systemctl restart "$SERVICE" && health_check; then
  printf '%s\n' "$target_sha" > "$STATE_DIR/active-sha"
  chmod 0644 "$STATE_DIR/active-sha"
  cleanup_archive=""
  rm -f -- "$archive"
  log "success sha=$target_sha previous=${previous_target:-none} release=$release"
  exit 0
fi

log "activation_failed sha=$target_sha attempting_rollback=${previous_target:-none}" >&2
if [ -n "$previous_target" ] && [ -d "$previous_target" ]; then
  rollback_link="${ACTIVE_LINK}.rollback.$$"
  rm -f -- "$rollback_link"
  ln -s "$previous_target" "$rollback_link"
  mv -Tf "$rollback_link" "$ACTIVE_LINK"
  if systemctl restart "$SERVICE" && health_check; then
    case "$release" in
      "$RELEASE_ROOT/$target_sha") rm -rf -- "$release" ;;
    esac
    fail "activation_failed_rolled_back sha=$target_sha previous=$previous_target"
  fi
  fail "activation_failed_rollback_health_failed sha=$target_sha previous=$previous_target"
fi

fail "activation_failed_no_previous_release sha=$target_sha"
