# Installed as /etc/deploy-manager/self-update.env by the one-time bootstrap.
# This file contains no webhook secret. Keep it root-owned so an unprivileged
# service process cannot redirect the root updater to a different repository.
DEPLOY_MANAGER_UPDATE_REPOSITORY=YesterdaysLemon/deploy-manager
DEPLOY_MANAGER_UPDATE_BRANCH=main
DEPLOY_MANAGER_UPDATE_WORKFLOW=check.yml
DEPLOY_MANAGER_REQUIRE_DEFAULT_BRANCH=1

DEPLOY_MANAGER_RELEASE_ROOT=/opt/deploy-manager-releases
DEPLOY_MANAGER_ACTIVE_LINK=/opt/deploy-manager-current
DEPLOY_MANAGER_UPDATE_STATE_DIR=/var/lib/deploy-manager-update
DEPLOY_MANAGER_UPDATE_LOCK_FILE=/run/lock/deploy-manager-update.lock
DEPLOY_MANAGER_ENV_FILE=/etc/deploy-manager/deploy-manager.env
DEPLOY_MANAGER_SERVICE=deploy-manager.service
DEPLOY_MANAGER_BUILD_USER=deploy-manager-build
DEPLOY_MANAGER_BUILD_HOME=/var/lib/deploy-manager-build

# Optional for a private repository or a higher GitHub API rate limit. The file
# must contain only the token and should be root:root mode 0600.
# DEPLOY_MANAGER_GITHUB_TOKEN_FILE=/etc/deploy-manager/github-token
