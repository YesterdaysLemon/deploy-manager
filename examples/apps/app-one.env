APP_ID=app-one
REPO_DIR=/opt/app-one/app
REPO_USER=deploy
BRANCH=main

IMAGE_NAME=app-one
CONTAINER_NAME=app-one
CANDIDATE_CONTAINER_NAME=app-one-candidate

APP_PORT=3010
CANDIDATE_APP_PORT=3011
CONTAINER_PORT=3000
HEALTH_PATH=/healthz

LOG_FILE=/opt/app-one/deploy.log

# Optional, only needed if the repo Dockerfile is not at REPO_DIR/Dockerfile.
# DOCKERFILE=Dockerfile
# DOCKER_BUILD_CONTEXT=.

# Optional, for runtime secrets passed into the app container.
# CONTAINER_ENV_FILE=/etc/deploy-manager/runtime-env/app-one.env
