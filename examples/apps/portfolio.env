APP_ID=portfolio
REPO_DIR=/opt/portfolio/app
REPO_USER=deploy
BRANCH=main

IMAGE_NAME=portfolio-app
CONTAINER_NAME=portfolio-app
CANDIDATE_CONTAINER_NAME=portfolio-app-candidate

APP_PORT=3000
CANDIDATE_APP_PORT=3001
CONTAINER_PORT=3000
HEALTH_PATH=/healthz

LOG_FILE=/opt/portfolio/deploy.log

# Optional, only needed if the repo Dockerfile is not at REPO_DIR/Dockerfile.
# DOCKERFILE=Dockerfile
# DOCKER_BUILD_CONTEXT=.

# Optional, for runtime secrets passed into the app container.
# CONTAINER_ENV_FILE=/etc/deploy-manager/runtime-env/portfolio.env
