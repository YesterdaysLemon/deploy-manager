APP_ID=birds
REPO_DIR=/opt/birdoftheday/app
REPO_USER=codex
BRANCH=master

IMAGE_NAME=birdoftheday-app
CONTAINER_NAME=birdoftheday-app
CANDIDATE_CONTAINER_NAME=birdoftheday-app-candidate

APP_PORT=3020
CANDIDATE_APP_PORT=3021
CONTAINER_PORT=3000
HEALTH_PATH=/healthz

LOG_FILE=/opt/birdoftheday/deploy.log

# Optional, only needed if the repo Dockerfile is not at REPO_DIR/Dockerfile.
# DOCKERFILE=Dockerfile
# DOCKER_BUILD_CONTEXT=.

# Optional, for runtime secrets passed into the app container.
# CONTAINER_ENV_FILE=/etc/deploy-manager/runtime-env/birds.env
