APP_ID=website
REPO_DIR=/opt/website/app
REPO_USER=codex
BRANCH=master

IMAGE_NAME=website-app
CONTAINER_NAME=website-app
CANDIDATE_CONTAINER_NAME=website-app-candidate

APP_PORT=3000
CANDIDATE_APP_PORT=3001
CONTAINER_PORT=3000
HEALTH_PATH=/healthz

LOG_FILE=/opt/website/deploy.log

# Optional, only needed if the repo Dockerfile is not at REPO_DIR/Dockerfile.
# DOCKERFILE=Dockerfile
# DOCKER_BUILD_CONTEXT=.

# Optional, for runtime secrets passed into the app container.
# CONTAINER_ENV_FILE=/etc/deploy-manager/runtime-env/website.env
