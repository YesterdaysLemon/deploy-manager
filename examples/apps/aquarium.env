APP_ID=aquarium
REPO_DIR=/opt/aquarium/app
REPO_USER=codex
BRANCH=master

IMAGE_NAME=aquarium-app
CONTAINER_NAME=aquarium-app
CANDIDATE_CONTAINER_NAME=aquarium-app-candidate

APP_PORT=3010
CANDIDATE_APP_PORT=3011
CONTAINER_PORT=3000
HEALTH_PATH=/healthz

LOG_FILE=/opt/aquarium/deploy.log

# Optional, only needed if the repo Dockerfile is not at REPO_DIR/Dockerfile.
# DOCKERFILE=Dockerfile
# DOCKER_BUILD_CONTEXT=.

# Optional, for runtime secrets passed into the app container.
# CONTAINER_ENV_FILE=/etc/deploy-manager/runtime-env/aquarium.env
