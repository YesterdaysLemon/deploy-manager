APP_ID=app-two
REPO_DIR=/opt/app-two/app
REPO_USER=deploy
BRANCH=main

IMAGE_NAME=app-two
CONTAINER_NAME=app-two
CANDIDATE_CONTAINER_NAME=app-two-candidate

APP_PORT=3020
CANDIDATE_APP_PORT=3021
CONTAINER_PORT=3000
HEALTH_PATH=/healthz

LOG_FILE=/opt/app-two/deploy.log

# Optional, only needed if the repo Dockerfile is not at REPO_DIR/Dockerfile.
# DOCKERFILE=Dockerfile
# DOCKER_BUILD_CONTEXT=.

# Optional, for runtime secrets passed into the app container.
# CONTAINER_ENV_FILE=/etc/deploy-manager/runtime-env/app-two.env
